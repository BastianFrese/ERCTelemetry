<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Named broadcast-look styles (nav rail, cards, window buttons, mono digits).
         Theme-neutral: colors via DynamicResource. BasedOn references the implicit
         styles in Inputs.xaml / Chrome.xaml — merge those dictionaries FIRST. -->

    <!-- Sidebar nav rail. -->
    <Style x:Key="NavRailListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>

    <Style x:Key="NavItemContainer" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppRacingFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Margin="6,1" Padding="14,10"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <!-- active-tab indicator: glow only renders while visible -->
                        <Rectangle x:Name="Ind" Width="3" HorizontalAlignment="Left" Margin="0,4"
                                   Fill="{DynamicResource AppAccent}" Visibility="Collapsed">
                            <Rectangle.Effect>
                                <DynamicResource ResourceKey="AppAccentShadow" />
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppRailHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <!-- accent-soft wash fading rightward (F1-TV active rail) -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF2E120C" Offset="0" />
                                        <GradientStop Color="#262E120C" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ind" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Broadcast card: glass panel with a subtle hover glow (website card look). -->
    <Style x:Key="BroadcastCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppGlow}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Hero card: highlighted panel; the consumer adds the 2px red top rule
         (website hero cards carry the red rule above the panel). -->
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource BroadcastCard}">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
    </Style>

    <!-- Uppercase micro-label (website eyebrow; WPF has no letter-spacing, the
         consumer supplies the text already uppercased). -->
    <Style x:Key="EyebrowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppEyebrowForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Stat tile: website hero KPI card — surface, 8px radius, big Orbitron value,
         small caption, 3px gradient bottom bar. -->
    <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource BroadcastCard}">
        <Setter Property="Padding" Value="16,12,16,0" />
    </Style>

    <Style x:Key="StatTileValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatTileCaption" TargetType="TextBlock" BasedOn="{StaticResource EyebrowLabel}">
        <Setter Property="FontSize" Value="10.5" />
   </Style>

    <!-- 3px gradient bottom bar of a stat tile (AppStatBar). -->
    <Style x:Key="StatTileBar" TargetType="Border">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="0,0,7,7" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource AppStatBar}" />
    </Style>

    <!-- Gauge bar (THR/BRK/ERS): track + fill, fill width driven by the consumer
         binding through PercentToWidthConverter. -->
    <Style x:Key="GaugeTrack" TargetType="Border">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource AppGridBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- GaugeFill: plain Border sized by the style; the consumer binds Background +
         Width. Border has no ControlTemplate, so the 1 px top hairline is added inline
         in each consumer (same pattern as the HUD fills) — see MainWindow.xaml. -->
    <Style x:Key="GaugeFill" TargetType="Border">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Card header text: Bahnschrift, red tick drawn inline by the consumer
         (AccentTick style) next to this TextBlock. -->
    <Style x:Key="BroadcastCardHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppRacingFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Telemetry digits (speed, gaps, sector times). -->
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppNumFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Window caption buttons (Segoe MDL2 Assets glyphs). -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppRailHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppStatusCritical}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red tick used next to section headers (3 x 14 accent bar). -->
    <Style x:Key="AccentTick" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Fill" Value="{DynamicResource AppAccent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Small uppercase section caption (nav rail groups, footer labels). -->
    <Style x:Key="BroadcastSectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppEyebrowForeground}" />
    </Style>
</ResourceDictionary>
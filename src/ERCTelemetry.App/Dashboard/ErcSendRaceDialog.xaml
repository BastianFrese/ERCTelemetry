<Window x:Class="ERCTelemetry.App.Dashboard.ErcSendRaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ergebnis an erdi-erc.de senden?"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">
    <StackPanel Margin="14">
        <TextBlock Text="LIGA-RENNEN BEENDET" FontWeight="Bold"
                   Foreground="{DynamicResource AppAccent}" />
        <TextBlock x:Name="TrackText" FontWeight="Bold" FontSize="16" Margin="0,2,0,0" />
        <TextBlock x:Name="DateText" Foreground="{DynamicResource AppDimForeground}" Margin="0,0,0,8" />
        <TextBlock x:Name="InfoText" Foreground="{DynamicResource AppDimForeground}" Margin="0,0,0,12" />

        <TextBlock Text="Liga" FontWeight="Bold" />
        <ComboBox x:Name="LeagueBox" Margin="0,4,0,12" MinWidth="320" HorizontalAlignment="Left"
                  SelectionChanged="LeagueBox_SelectionChanged" />

        <TextBlock Text="Das Ergebnis landet als Entwurf im Admin-Dashboard und wird dort geprüft, bevor es auf der Seite erscheint."
                   Foreground="{DynamicResource AppDimForeground}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SendButton" Content="AN ERDI-ERC.DE SENDEN" Click="Send_Click"
                    IsEnabled="False" Style="{StaticResource BroadcastPrimaryButton}" />
            <Button Content="Später" Width="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

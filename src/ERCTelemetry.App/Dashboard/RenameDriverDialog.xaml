<Window x:Class="ERCTelemetry.App.Dashboard.RenameDriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename driver" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">
    <StackPanel Margin="12">
        <TextBlock Text="Game name:" FontWeight="Bold" />
        <TextBlock x:Name="GameNameText" Margin="0,2,0,10"
                   Foreground="{DynamicResource AppBannerText}" />
        <TextBlock Text="Shown as (empty = use the game name again):" FontWeight="Bold" />
        <TextBox x:Name="NameBox" Margin="0,4,0,12"
                 ToolTip="Applies to the standings, the HUD, the OBS overlays and session history" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="72" Click="Ok_Click" IsDefault="True" />
            <Button Content="Cancel" Width="72" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
<UserControl x:Class="ERCTelemetry.App.Dashboard.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Session card: track tile (image, else monogram on a stable tint), name,
             type badge, team color, best lap, rounds, date. Click → detail. -->
        <DataTemplate x:Key="SessionCardTemplate">
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,12,12"
                    Cursor="Hand" MouseLeftButtonUp="Card_Click" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Track tile: image when embedded, monogram fallback otherwise. -->
                    <Border Width="84" Height="84" CornerRadius="6" Margin="0,0,14,0"
                            VerticalAlignment="Top" ClipToBounds="True"
                            BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding ImageUri}" Stretch="Uniform" Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Background="{Binding TileBackground}" CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageUri}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Monogram}"
                                           FontFamily="{DynamicResource AppDisplayFont}"
                                           FontSize="24" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Track}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{DynamicResource AppSurfaceAlt}"
                                    BorderBrush="{DynamicResource AppCardBorder}"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding Badge}" FontSize="9"
                                           Foreground="{DynamicResource AppMutedForeground}" />
                            </Border>
                            <TextBlock Text="{Binding Team}" Margin="8,0,0,0" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding TeamBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BestLap}" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource AppDisplayFont}" FontSize="20"
                                   FontWeight="Bold" Foreground="{DynamicResource AppForeground}" />
                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppStatusGood}">
                            <Run Text="{Binding LapCount, Mode=OneWay}" /><Run Text=" Runden · " />
                            <Run Text="{Binding DriverCount, Mode=OneWay}" /><Run Text=" Fahrer" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Right rail: date + state (open/crashed tinted, finished quiet). -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AppMutedForeground}" />
                        <TextBlock HorizontalAlignment="Right" Margin="0,6,0,0" FontSize="9.5"
                                   FontWeight="Bold" Text="OFFEN">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EyebrowLabel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource AppStatusWarn}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Finalized}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right" Margin="0,6,0,0" FontSize="9.5"
                                   FontWeight="Bold" Text="ABGEBROCHEN">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EyebrowLabel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Finalized}" Value="2">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <!-- Kopf -->
            <TextBlock Text="DEINE SESSIONS" Style="{StaticResource StatTileCaption}"
                       FontSize="13" Margin="0,0,0,4" />
            <TextBlock Text="{Binding CareerSummary}" Margin="0,0,0,12"
                       Foreground="{DynamicResource AppMutedForeground}" />

            <!-- ===== MEISTERSCHAFT (alle gespeicherten Rennen) ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="MEISTERSCHAFT (ALLE GESPEICHERTEN RENNEN)"
                               Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="FAHRERWERTUNG" Style="{StaticResource EyebrowLabel}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding ChampionshipRows}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="30" />
                                    <DataGridTextColumn Header="Fahrer" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="90" />
                                    <DataGridTextColumn Header="Rennen" Binding="{Binding Races}" Width="50" />
                                    <DataGridTextColumn Header="Punkte" Binding="{Binding Points}" Width="55" />
                                    <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="40" />
                                    <DataGridTextColumn Header="Podiums" Binding="{Binding Podiums}" Width="55" />
                                    <DataGridTextColumn Header="Beste Pos." Binding="{Binding BestPosition}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="KONSTRUKTEURS-WERTUNG" Style="{StaticResource EyebrowLabel}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding ConstructorRows}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="30" />
                                    <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="*" />
                                    <DataGridTextColumn Header="Rennen" Binding="{Binding Races}" Width="50" />
                                    <DataGridTextColumn Header="Punkte" Binding="{Binding Points}" Width="55" />
                                    <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="40" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="FORMKURVE (DEINE PUNKTE PRO RENNEN)"
                               Style="{StaticResource EyebrowLabel}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding FormRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1,0,1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Points}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource AppMutedForeground}" />
                                    <TextBlock DockPanel.Dock="Right" Text=" pts" FontSize="10.5" Margin="0,0,4,0"
                                               Foreground="{DynamicResource AppMutedForeground}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" Margin="0,0,12,0"
                                               FontFamily="Cascadia Mono, Consolas" FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentText}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" Margin="12,0,0,0"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource AppMutedForeground}" />
                                    <TextBlock Text="{Binding Track}" FontSize="11" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Noch keine gewerteten Rennen — beende ein Rennen mit aktiver Aufnahme."
                               Foreground="{DynamicResource AppMutedForeground}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChampionshipRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== FAHRER-RATING (ELO, lokal) ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="FAHRER-RATING (ELO, LOKAL)"
                               Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PlayerRating, StringFormat=Dein ELO: {0}}"
                               Style="{StaticResource EyebrowLabel}" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding RatingRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="220">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background"
                                                Value="{DynamicResource AppRowHighlight}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="30" />
                            <DataGridTextColumn Header="Fahrer" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="90" />
                            <DataGridTextColumn Header="Rennen" Binding="{Binding Races}" Width="50" />
                            <DataGridTextColumn Header="ELO" Binding="{Binding Rating}" Width="55" />
                            <DataGridTextColumn Header="Siege" Binding="{Binding Wins}" Width="40" />
                            <DataGridTextColumn Header="Beste Pos." Binding="{Binding BestPosition}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Noch keine gewerteten Rennen — beende ein Rennen mit aktiver Aufnahme."
                               Foreground="{DynamicResource AppMutedForeground}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RatingRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Filter -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="FILTER" Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Strecke" Style="{StaticResource EyebrowLabel}" Margin="0,0,6,0" />
                        <ComboBox Width="190" ItemsSource="{Binding TrackOptions}"
                                  SelectedItem="{Binding FilterTrack}" />
                        <TextBlock Text="Session-Typ" Style="{StaticResource EyebrowLabel}"
                                   Margin="14,0,6,0" />
                        <ComboBox Width="170" ItemsSource="{Binding SessionTypeOptions}"
                                  SelectedItem="{Binding FilterSessionType}" />
                        <TextBlock Text="Zeitraum" Style="{StaticResource EyebrowLabel}"
                                   Margin="14,0,6,0" />
                        <ComboBox Width="110" SelectedIndex="{Binding FilterRangeIndex}">
                            <ComboBoxItem Content="Gesamt" />
                            <ComboBoxItem Content="7 Tage" />
                            <ComboBoxItem Content="30 Tage" />
                        </ComboBox>
                        <Button Content="Aktualisieren" Click="Refresh_Click"
                                Padding="12,2" Margin="14,0,0,0" />
                        <TextBlock Text="{Binding Status}" Margin="12,0,0,0"
                                   FontStyle="Italic" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedForeground}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kartenraster (2 Spalten) -->
            <ItemsControl ItemsSource="{Binding Cards}"
                          ItemTemplate="{StaticResource SessionCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Noch keine Sessions gespeichert — starte eine Session mit aktiver Aufnahme."
                       Foreground="{DynamicResource AppMutedForeground}" Margin="4,8,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cards.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,12,0">
                <Button Content="‹" Click="Prev_Click" Padding="10,2" MinWidth="34"
                        IsEnabled="{Binding CanGoBack}" />
                <ItemsControl ItemsSource="{Binding PageItems}" Margin="4,0,0,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Number}" Tag="{Binding Number}"
                                    Click="Page_Click" Padding="8,2" MinWidth="34"
                                    Margin="3,0,0,0" FontWeight="Regular">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="›" Click="Next_Click" Padding="10,2" MinWidth="34"
                        Margin="3,0,0,0" IsEnabled="{Binding CanGoForward}" />
                <TextBlock Text="{Binding PageLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMutedForeground}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
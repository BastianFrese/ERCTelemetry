                                                <TextBlock Text="OVERLAYS (OBS-SEITEN)" Style="{StaticResource BroadcastCardHeader}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Welche Blöcke die OBS-Overlay-Seiten anzeigen."

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Position / Name / Gap-Zeile zeigen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowTiming}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Speed, Gang, RPM, Pedals, ERS zeigen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowDrive}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DRS / Reifen / Fuel-Zeile zeigen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowStatus}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Minimap zeigen (Fahrzeugpositionen)"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowMap}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Wetter-Vorhersage-Zeile zeigen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowWeather}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Renn-Infos zeigen (Pit-Fenster, Uhr, Flaggen, Damage, Tyre-Bank)"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Pit-Fenster-Hinweis, Sitzungsuhr, Marshal-Flagge, Runde-ungültig-Badge, Body-Damage, bester frischer Reifensatz, Traffic-Warnungen, Fuel-Verbrauch pro Runde" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowRace}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Radar / Blind-Spot zeigen (Autos neben und kurz hinter dir)"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Zeichnet Autos in einem Kegel von 45 m hinter bis 10 m vor dem Spieler; rot = innerhalb einer Sekunde Renngap" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowRadar}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Meter zeigen (Quer- und Längskräfte als Fadenkreuz-Punkt)"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Zeichnet die auf das Fahrzeug wirkenden Kräfte: seitlich (Kurven) und längs (Bremsen unten, Beschleunigen oben); Skala bis 3 g" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowGmeter}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Timing-Tower zeigen (Feld mit Mini-Sektor-Marken grün/lila)"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"

                                            </Grid>
                                            <TextBlock Text="Position und Sichtbarkeit greifen beim nächsten Save; HUD ziehen über Tray-Menü → Overlay position mode"
                                                       Style="{StaticResource SettingsSectionHint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SettingsCardOverlays" Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- ===== Debug ===== -->
                    <Grid x:Name="DebugTab" Visibility="Collapsed" Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ListenerStatus}" Margin="0,0,24,0"
                                       VerticalAlignment="Center" FontStyle="Italic"
                                       ToolTip="UDP-Status — umgeschaltet wird in der Kopfzeile" />
                            <TextBlock Text="{Binding OverlayStatus}"
                                       ToolTip="OBS-Browser-Source: eine dieser URLs hinzufügen (z. B. /overlay/standings.html)" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Totals}" Margin="0,0,0,8" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{Binding IsRecording, Converter={StaticResource BoolToRecordingText}}"
                                    Click="RecordButton_Click" />
                            <TextBox Text="{Binding RecordPath, UpdateSourceTrigger=PropertyChanged}"
                                     Width="420" Margin="8,0,0,0" VerticalAlignment="Center"
                                     ToolTip="Leer lassen, um nach %LOCALAPPDATA%\ERCTelemetry aufzunehmen" />
                        </StackPanel>

                        <!-- replay row: play a .f1rec recording into the live pipeline -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Replay-Datei…" Click="ReplayFile_Click"
                                    ToolTip="Aufnahme (.f1rec) wählen — der Live-Listener wird beim Start gestoppt" />
                            <Button Content="Replay ▶" Click="ReplayPlay_Click" Margin="8,0,0,0"
                                    Style="{StaticResource BroadcastPrimaryButton}" />
                            <Button Content="Replay ■" Click="ReplayStop_Click" Margin="4,0,0,0" />
                            <ComboBox x:Name="ReplaySpeedBox" Width="70" Margin="8,0,0,0"
                                      SelectedIndex="1" VerticalAlignment="Center">
                                <ComboBoxItem Content="0.5×" />
                                <ComboBoxItem Content="1×" />
                                <ComboBoxItem Content="2×" />
                                <ComboBoxItem Content="4×" />
                            </ComboBox>
                            <TextBlock Text="{Binding ReplayStatus}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontStyle="Italic" />
                        </StackPanel>

                        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Packet type" Binding="{Binding Type}" Width="180" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="120" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- broadcast footer: chequered flag strip on top, wordmark left, totals right -->
            <Border Grid.Row="4" Height="34" Background="{DynamicResource AppRail}"
                    BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Rectangle DockPanel.Dock="Top" Height="4" Fill="{DynamicResource AppChequer}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Totals}" FontFamily="{DynamicResource AppNumFont}"
                                   FontSize="11" Foreground="{DynamicResource AppMutedForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource AccentTick}" Height="10" />
                        <TextBlock Text="ERC TELEMETRY" Style="{StaticResource BroadcastSectionLabel}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="· F1 26 UDP TELEMETRY" FontFamily="{DynamicResource AppRacingFont}"
                                   FontSize="11" Foreground="{DynamicResource AppMutedForeground}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
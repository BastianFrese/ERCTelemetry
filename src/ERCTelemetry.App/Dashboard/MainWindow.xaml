                                            <TextBlock Text="HEAD-TO-HEAD-SEITE (H2H.HTML)" Style="{StaticResource SettingsSubHeader}" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Kopfzeile &amp; Fahrer-Auswahl"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayH2hHeader}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Letzte &amp; beste Runde"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayH2hLaps}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sektorvergleich"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayH2hSectors}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Reifen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayH2hTyres}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Boxenstatus"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayH2hPits}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Duell-Bilanz"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayH2hTally}" />
                                            </Grid>

                                            <TextBlock Text="KOMMENTAR-SEITE (COMMENTARY.HTML)" Style="{StaticResource SettingsSubHeader}" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sitzungskontext"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayComSession}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Duelle unter 1 s"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayComBattles}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Positionsgewinner vs. Start"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayComMovers}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Schnellste Runden"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayComFastest}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Boxen &amp; Ausfälle"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayComPits}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Älteste Reifen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding OverlayComTyres}" />
                                            </Grid>

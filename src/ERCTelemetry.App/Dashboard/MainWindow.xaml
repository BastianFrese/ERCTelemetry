                                            <TextBlock Text="Öffnet den Browser zur Twitch-Freigabe — Kanal und Anzeigename werden automatisch erkannt. Die App muss einmalig unter dev.twitch.tv mit der Redirect-URI https://telemetrie.erdi-erc.de/twitch/callback registriert sein."
                                                       Style="{StaticResource SettingsSectionHint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SettingsCardClips" Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Rectangle Style="{StaticResource AccentTick}" />
                                                <TextBlock Text="KOLLISIONS-CLIPS" Style="{StaticResource BroadcastCardHeader}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Nimmt bei Kollisionen automatisch Bildschirm-Clips auf."
                                                       Style="{StaticResource SettingsSectionHint}" />
                                            <TextBlock Text="AKTIVIERUNG" Style="{StaticResource SettingsSubHeader}" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Bei Kollisionen automatisch einen Bildschirm-Clip aufnehmen" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Nur in Online-Rennen. Benötigt ffmpeg.exe neben der App (wird mit dem Installer mitgeliefert)." />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding ClipEnabled}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nur Kollisionen mit dem eigenen Fahrer aufnehmen"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding ClipOnlyPlayer}" />
                                            </Grid>
                                            <TextBlock Text="AUFNAHME" Style="{StaticResource SettingsSubHeader}" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Mindest-Schwere" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Gering = jede Kollision, Mittel = nur mittlere und harte Einschläge, Hoch = nur harte" />
                                                <ComboBox Grid.Column="1" Width="120" VerticalAlignment="Center"
                                                          ItemsSource="{Binding ClipSeverityOptions}"
                                                          SelectedValue="{Binding ClipMinSeverity}"
                                                          SelectedValuePath="Value" DisplayMemberPath="Label" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sekunden vor der Kollision (1–60)" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <TextBox Grid.Column="1" Text="{Binding ClipPreRollSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="60" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sekunden nach der Kollision (1–60)" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <TextBox Grid.Column="1" Text="{Binding ClipPostRollSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="60" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Bilder pro Sekunde (1–60)" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Höher = flüssiger, aber mehr CPU-Last und größere Dateien. 30–60 wirken wie ein richtiges Video, 10 ist ein guter Kompromiss." />
                                                <TextBox Grid.Column="1" Text="{Binding ClipFps, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="60" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Audio-Gerät (Clip-Ton)" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Welche Ausgabe-Gerät der Clip-Ton aufnimmt (Loopback). Standard = das aktive Standard-Ausgabegerät." />

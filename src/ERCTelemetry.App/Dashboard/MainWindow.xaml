                                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                          IsChecked="{Binding HudShowTower}" />
                                            </Grid>
                                            <TextBlock Text="RIVAL" Style="{StaticResource SettingsSubHeader}" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Rival-Panel zeigen (Auto-Zyklus + Ctrl+Shift+R)"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"

                                                          ItemsSource="{Binding AudioDeviceOptions}"
                                                          SelectedValue="{Binding SelectedAudioDevice}"
                                                          SelectedValuePath="Name" DisplayMemberPath="Label" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Auflösung (max. Breite)" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,16,0"
                                                           ToolTip="Maximale Clip-Breite in Pixeln; das Seitenverhältnis bleibt erhalten. Höher = schärfer, aber mehr CPU-Last und größere Dateien." />
                                                <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                          ItemsSource="{Binding ClipMaxWidthOptions}"
                                                          SelectedValue="{Binding ClipMaxWidth}"
                                                          SelectedValuePath="Value" DisplayMemberPath="Label" />
                                            </Grid>
                                            <TextBlock Text="Clips landen unter %LOCALAPPDATA%\ERCTelemetry\clips und erscheinen in der Session-History. Fehlt ffmpeg.exe, bleibt die Aufnahme deaktiviert."
                                                       Style="{StaticResource SettingsSectionHint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="SettingsCardHud" Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

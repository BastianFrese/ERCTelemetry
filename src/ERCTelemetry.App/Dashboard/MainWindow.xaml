<Window x:Class="ERCTelemetry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ERCTelemetry.App.Dashboard"
        Title="ERCTelemetry — F1 Telemetry"
        Height="700" Width="1120"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <local:BoolToRecordingTextConverter x:Key="BoolToRecordingText" />
        <local:LapTimeConverter x:Key="LapTimeConverter" />
        <local:GapConverter x:Key="GapConverter" />
        <local:PitStatusConverter x:Key="PitStatusConverter" />
        <local:TyreCompoundConverter x:Key="TyreCompoundConverter" />
        <local:SectorTimeConverter x:Key="SectorTimeConverter" />
        <local:PercentToWidthConverter x:Key="PercentToWidth" />
        <local:TyreTempToBrushConverter x:Key="TyreTempToBrush" />
        <local:TeamToBrushConverter x:Key="TeamToBrush" />
        <local:SessionSecondsConverter x:Key="SessionSeconds" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Settings-tab shared styles: section description, sub-group header, label column. -->
        <Style x:Key="SettingsSectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource AppDimForeground}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SettingsSubHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppEyebrowForeground}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <!-- Mobile-style switch for on/off settings. The label lives in a separate row
             TextBlock (label left, switch right) — this template renders only the switch. -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AppChromeBorder}"
                                    BorderBrush="{DynamicResource AppChromeBorder}" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="2,0,0,0"
                                         HorizontalAlignment="Left" Fill="{DynamicResource AppForeground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AppAccent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AppAccentText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Maximize safety net: a borderless window overhangs the screen by its resize
         border; pull the whole shell in while maximized. -->
    <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource AppDivider}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar: wordmark left; lamp, listener toggle, game pill, window
                 buttons right. Interactive children need IsHitTestVisibleInChrome so
                 clicks there don't become caption drags. -->
            <Border Grid.Row="0" Height="52" Background="{DynamicResource AppRail}">
                <Border BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <!-- window buttons: docked right, first = rightmost -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeWindow_Click"
                                    ToolTip="Minimieren">
                                <TextBlock Text="&#xE921;" />
                            </Button>
                            <Button x:Name="MaxButton" Style="{StaticResource WindowButtonStyle}"
                                    Click="MaximizeWindow_Click" ToolTip="Maximieren / Wiederherstellen">
                                <TextBlock x:Name="MaxGlyph" Text="&#xE922;" />
                            </Button>
                            <Button Style="{StaticResource WindowCloseButtonStyle}" Click="CloseWindow_Click"
                                    ToolTip="Schließen (minimiert in den Tray, wenn aktiviert)">
                                <TextBlock Text="&#xE8BB;" />
                            </Button>
                        </StackPanel>

                        <!-- game-status pill: green border while packets flow -->
                        <Border DockPanel.Dock="Right" Margin="0,0,12,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Ob gerade UDP-Pakete vom Spiel ankommen">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReceivingPackets}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppStatusGood}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReceivingPackets}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AppStatusGood}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding GamePillText}" FontSize="12"
                                           Foreground="{DynamicResource AppBannerText}" />
                            </StackPanel>
                        </Border>

                        <!-- listener lamp + toggle -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Ellipse Margin="0,0,7,0"
                                     ToolTip="Listener-Status (Start/Stopp in Settings → Verbindung)">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AppStatusGood}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Button Style="{StaticResource BroadcastPrimaryButton}"
                                    Content="{Binding ListenerButtonText}"
                                    Click="ListenerToggle_Click"
                                    ToolTip="Startet/stopped den UDP-Listener mit dem gespeicherten Port (Settings → Verbindung)" />
                        </StackPanel>

                        <!-- wordmark: chequered flag strip → red tick → ERC (glow) TELEMETRY -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Rectangle Width="6" Height="22" Margin="0,0,10,0"
                                       Fill="{DynamicResource AppChequer}" />
                            <Rectangle Style="{StaticResource AccentTick}" Height="22" Margin="0,0,10,0" />
                            <TextBlock Text="ERC" FontFamily="{DynamicResource AppDisplayFont}" FontSize="20"
                                       FontWeight="Bold" Foreground="{DynamicResource AppAccent}"
                                       Effect="{DynamicResource AppAccentShadow}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="TELEMETRY" FontFamily="{DynamicResource AppDisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Margin="6,0,0,0"
                                       Foreground="{DynamicResource AppForeground}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="F1 TELEMETRY" FontFamily="{DynamicResource AppBodyFont}" FontSize="10"
                                       Foreground="{DynamicResource AppEyebrowForeground}" Margin="14,4,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- fill child: broadcast red rule fading out along the header's
                             bottom edge (F1-TV look), 3 px tall -->
                        <Rectangle Height="3" Fill="{DynamicResource AppHeaderRule}"
                                   VerticalAlignment="Bottom" />
                    </DockPanel>
                </Border>
            </Border>

            <!-- update banner: prominent, visible on every tab while an update is offered -->
            <Border Grid.Row="1" Background="{DynamicResource AppBannerBackground}"
                    BorderBrush="{DynamicResource AppAccent}" BorderThickness="0,1"
                    Padding="14,8"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BroadcastPrimaryButton}"
                            Content="Update installieren" Click="UpdateInstall_Click"
                            ToolTip="Lädt das Setup herunter (SHA256-geprüft) und startet es"
                            Margin="12,0,0,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                    <Setter Property="Fill" Value="{DynamicResource AppStatusWarn}" />
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="UPDATE VERFÜGBAR" FontFamily="{DynamicResource AppDisplayFont}"
                                   FontSize="13" FontWeight="Bold" Margin="10,0,12,0"
                                   Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateBannerText}" FontSize="12"
                                   Foreground="{DynamicResource AppBannerText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- format warning strip (only while FormatWarning is set) -->
            <Border Grid.Row="2" Background="{DynamicResource AppBannerBackground}"
                    BorderBrush="{DynamicResource AppBannerBorder}" BorderThickness="0,1,0,1"
                    Padding="14,4"
                    Visibility="{Binding FormatWarning, Converter={StaticResource NullToCollapsedConverter}}">
                <TextBlock Text="{Binding FormatWarning}" Foreground="{DynamicResource AppBannerText}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- body: nav rail + content panels -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource AppRail}"
                        BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                            <TextBlock Text="STATUS" Style="{StaticResource BroadcastSectionLabel}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ListenerStatus}" FontFamily="{DynamicResource AppNumFont}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppMutedForeground}" />
                        </StackPanel>
                        <ListBox x:Name="NavList" Style="{StaticResource NavRailListBox}"
                                 SelectionChanged="NavList_SelectionChanged">
                            <!-- section caption: disabled items are never selectable -->
                            <ListBoxItem IsEnabled="False" Focusable="False" Style="{StaticResource NavItemContainer}">
                                <TextBlock Text="TELEMETRY" Style="{StaticResource BroadcastSectionLabel}" Margin="14,6,0,2" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="setup">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="01" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="SETUP" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="02" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="DASHBOARD" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="racecontrol">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="03" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="RACE CONTROL" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem IsEnabled="False" Focusable="False" Style="{StaticResource NavItemContainer}">
                                <TextBlock Text="DATA" Style="{StaticResource BroadcastSectionLabel}" Margin="14,6,0,2" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="history">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="04" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="HISTORY" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="setups">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="05" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="SETUPS" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem IsEnabled="False" Focusable="False" Style="{StaticResource NavItemContainer}">
                                <TextBlock Text="SYSTEM" Style="{StaticResource BroadcastSectionLabel}" Margin="14,6,0,2" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="06" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="SETTINGS" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="DebugNavItem" Style="{StaticResource NavItemContainer}" Tag="debug">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="07" FontFamily="{DynamicResource AppNumFont}" FontSize="11"
                                               Width="26" Foreground="{DynamicResource AppDimForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="DEBUG" FontFamily="{DynamicResource AppDisplayFont}"
                                               FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <!-- ===== Setup ===== -->
                    <Grid x:Name="SetupTab" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="1200" HorizontalAlignment="Left" Margin="16,14,16,16">
                                <TextBlock Text="VERBINDUNGS-CHECKLISTE" FontFamily="{DynamicResource AppDisplayFont}"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <ItemsControl Margin="0,0,0,14">
                                    <ItemsControl.Items>
                                        <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppStatusGood}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="1. Telemetrie-Listener läuft" FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ListenerStatus}" FontSize="12"
                                                               Foreground="{DynamicResource AppMutedForeground}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReceivingPackets}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppStatusGood}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="2. F1 26 sendet Telemetrie" FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource AppMutedForeground}"
                                                               Text="Im Spiel: Einstellungen → Telemetrie → UDP aktivieren, Port wie in Settings → Verbindung, Format '2026 Season Pack'. Auf einer Konsole als IP die LAN-IP von unten eintragen." />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SetupOverlayLive}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppStatusGood}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="3. Overlay-Server läuft (OBS)" FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding OverlayStatus}" FontSize="12"
                                                               Foreground="{DynamicResource AppMutedForeground}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource BroadcastCard}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource StatusLamp}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SetupObsConnected}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppStatusGood}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="4. OBS-Browser-Source verbunden" FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource AppMutedForeground}"
                                                               Text="In OBS: Quellen → + → Browser, dann eine der URLs unten einfügen" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ItemsControl.Items>
                                </ItemsControl>

                                <!-- Console / second PC: the game cannot reach 127.0.0.1 on
                                     another device — show this machine's LAN IP + port. -->
                                <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Style="{StaticResource AccentTick}" VerticalAlignment="Center" />
                                            <TextBlock Text="Konsole / Laptop verbinden"
                                                       FontFamily="{DynamicResource AppRacingFont}" FontSize="15"
                                                       FontWeight="SemiBold" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource AppMutedForeground}"
                                                   Text="Läuft das Spiel auf einer Konsole (oder einem zweiten PC), sendet es die Telemetrie über das Netzwerk: Im Spiel unter Einstellungen → Telemetrie UDP aktivieren und als IP die LAN-IP dieses Rechners eintragen (nur wenn Spiel und App auf demselben Gerät laufen, ist es 127.0.0.1)." />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="LAN-IP" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppMutedForeground}" FontSize="11" />
                                            <TextBlock Text="{Binding LanIp}" FontFamily="{DynamicResource AppNumFont}"
                                                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       ToolTip="{Binding LanIpAlternatives}" />
                                            <Button Content="IP kopieren" Click="CopyLanIp_Click" Margin="12,0,0,0"
                                                    ToolTip="Diese Adresse im Spiel auf der Konsole eingeben" />
                                            <TextBlock Text="UDP-Port" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppMutedForeground}" FontSize="11"
                                                       Margin="24,0,0,0" />
                                            <TextBlock Text="{Binding ConsolePortText}"
                                                       FontFamily="{DynamicResource AppNumFont}" FontSize="20"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <Button Content="Port kopieren" Click="CopyUdpPort_Click" Margin="12,0,0,0"
                                                    ToolTip="Diesen Port im Spiel auf der Konsole eingeben" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">

                                <!-- Updates: silent manifest check at startup + manual check;
                                     install launches the SHA256-verified Setup.exe (UAC) and
                                     shuts the app down so the installer can replace it. -->
                                <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Style="{StaticResource AccentTick}" VerticalAlignment="Center" />
                                            <TextBlock Text="Updates"
                                                       FontFamily="{DynamicResource AppRacingFont}" FontSize="15"
                                                       FontWeight="SemiBold" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppMutedForeground}" />
                                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="4"
                                                     Value="{Binding UpdateProgress, Mode=OneWay}"
                                                     Visibility="Collapsed" Margin="0,10,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="UpdateCheckButton" Content="Nach Updates suchen"
                                                    Click="UpdateCheck_Click"
                                                    ToolTip="Prüft erdi-erc.de auf eine neue Version" />
                                            <Button Content="Update-Log" Click="OpenUpdateLog_Click" Margin="12,0,0,0"
                                                    ToolTip="Öffnet das Update-Log (UPDATELOG.md) — was in welcher Version neu ist" />
                                            <Button x:Name="UpdateInstallButton"
                                                    Content="Update herunterladen &amp; installieren"
                                                    Click="UpdateInstall_Click" Margin="12,0,0,0" Visibility="Collapsed"
                                                    ToolTip="Lädt das Setup herunter (SHA256-geprüft) und startet es — UAC-Frage, danach schließt sich die App selbst" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Expander Header="Overlay-URLs für OBS (Klick kopiert in die Zwischenablage)"
                                          IsExpanded="False" Margin="0,0,0,12">
                                    <StackPanel Margin="0,8,0,0">
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Broadcast-Hauptoverlay" Click="CopyOverlayUrl_Click" Tag="broadcast"
                                                    Margin="0,0,8,4"
                                                    ToolTip="Die große Alles-auf-einer-Seite-Oberfläche (1920×1080)" />
                                            <Button Content="Standings" Click="CopyOverlayUrl_Click" Tag="standings" Margin="0,0,8,4" />
                                            <Button Content="Timing tower" Click="CopyOverlayUrl_Click" Tag="timing-tower" Margin="0,0,8,4" />
                                            <Button Content="Player card" Click="CopyOverlayUrl_Click" Tag="player-card" Margin="0,0,8,4" />
                                            <Button Content="Minimap" Click="CopyOverlayUrl_Click" Tag="map" Margin="0,0,8,4" />
                                            <Button Content="Race control" Click="CopyOverlayUrl_Click" Tag="race-control" Margin="0,0,8,4" />
                                            <Button Content="Tyre heatmap" Click="CopyOverlayUrl_Click" Tag="tyres" Margin="0,0,8,4" />
                                            <Button Content="Telemetry panel" Click="CopyOverlayUrl_Click" Tag="telemetry" Margin="0,0,8,4" />
                                            <Button Content="Commentary pack" Click="CopyOverlayUrl_Click" Tag="commentary" Margin="0,0,8,4" />
                                            <Button Content="H2H-Duell" Click="CopyOverlayUrl_Click" Tag="h2h" Margin="0,0,8,4" />
                                            <Button Content="Relative" Click="CopyOverlayUrl_Click" Tag="relative" Margin="0,0,8,4" />
                                            <Button Content="Minimap 480×300" Click="CopyOverlaySizedUrl_Click" Tag="map:480,300"
                                                    Margin="0,0,8,4"
                                                    ToolTip="Minimap-URL mit fester Canvas-Größe (?w=&amp;h=) — OBS rendert das Widget pixelgenau" />
                                            <Button Content="Minimap 600×360" Click="CopyOverlaySizedUrl_Click" Tag="map:600,360"
                                                    Margin="0,0,8,4"
                                                    ToolTip="Minimap-URL mit fester Canvas-Größe (?w=&amp;h=) — OBS rendert das Widget pixelgenau" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SetupCopied}" FontStyle="Italic" Margin="0,0,0,4"
                                                   Foreground="{DynamicResource AppStatusGood}" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="So funktioniert's" IsExpanded="False" Margin="0,0,0,12">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="ERCTelemetry hört UDP-Pakete von F1 26 (Port aus Settings → Verbindung, standardmäßig 20778) und zeigt daraus Dashboard, In-Game-HUD und die OBS-Overlays an. Der UDP-Listener wird in der Kopfzeile gestartet/gestoppt." />
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="Spiel auf demselben PC: Einstellungen → Telemetrie-Einstellungen → UDP aktivieren • IP 127.0.0.1 • Port wie in der App • Format '2026 Season Pack'. Spiel auf Konsole/zweitem PC: statt 127.0.0.1 die LAN-IP von oben eintragen — die Firewall-Freigabe legt die App beim ersten Start an (einmalige UAC-Abfrage)." />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock x:Name="FirewallStatusText" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppMutedForeground}" />
                                            <Button x:Name="FirewallAddButton" Content="Firewall-Freigabe jetzt erlauben"
                                                    Click="FirewallAdd_Click" Margin="8,0,0,0" Visibility="Collapsed"
                                                    ToolTip="Legt die Windows-Firewall-Regel für eingehende UDP-Telemetrie an (einmalige UAC-Abfrage)" />
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="OBS: Eine Browser-Source pro Widget — oder nur die Broadcast-Seite in 1920×1080. 'Shutdown source when not visible' aus lassen; die Seiten verbinden sich selbst neu." />
                                        <TextBlock x:Name="SetupVersionText" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource AppMutedForeground}" FontSize="11"
                                                   Text="ERCTelemetry" />
                                    </StackPanel>
                                </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                    <!-- ===== Dashboard ===== -->
                    <Grid x:Name="DashboardTab" Visibility="Collapsed" Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Hero session bar: four stat tiles + rival picker, red rule below. -->
                        <Border Grid.Row="0" Style="{StaticResource HeroCard}" Padding="0" Margin="0,0,0,12"
                                ClipToBounds="True">
                            <Grid>
                            <StackPanel>
                                <!-- 4 px chequered flag top strip (F1-TV hero) -->
                                <Rectangle Height="4" Fill="{DynamicResource AppChequer}" />
                                <DockPanel Margin="16,12,16,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="COMPARE VS" Style="{StaticResource EyebrowLabel}" Margin="0,0,8,0" />
                                        <ComboBox Width="200"
                                                  ItemsSource="{Binding Drivers}"
                                                  SelectedItem="{Binding SelectedRivalName}" />
                                    </StackPanel>
                                    <UniformGrid Columns="4">
                                        <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                                            <Grid>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="SESSION" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource StatTileValue}" Margin="0,2,0,0"
                                                               Text="{Binding Current.Meta.SessionType, FallbackValue=–}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource StatTileBar}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                                            <Grid>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="TRACK" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource StatTileValue}" Margin="0,2,0,0"
                                                               Text="{Binding Current.Meta.Track, FallbackValue=–}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource StatTileBar}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                                            <Grid>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="TIME LEFT" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource StatTileValue}" Margin="0,2,0,0"
                                                               Text="{Binding Current.Meta.SessionTimeLeft, Converter={StaticResource SessionSeconds}, FallbackValue=–}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource StatTileBar}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource StatTile}">
                                            <Grid>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="WEATHER" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource StatTileValue}" Margin="0,2,0,0"
                                                               Text="{Binding Current.Meta.Weather, FallbackValue=–}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource StatTileBar}" />
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </DockPanel>
                                <TextBlock Margin="16,0,16,8" Text="{Binding ForecastSummary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatTileCaption}">
                                            <Setter Property="Foreground" Value="{DynamicResource AppStatusInfo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ForecastSummary}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- F1-TV hero rule: red fading rightward -->
                                <Rectangle Height="3" Fill="{DynamicResource AppHeaderRule}" />
                            </StackPanel>
                            <!-- speed-line texture across the whole hero (non-interactive) -->
                            <Rectangle Fill="{DynamicResource AppSpeedLines}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                        <DataGrid x:Name="StandingsGrid" ItemsSource="{Binding Standings}" AutoGenerateColumns="False"
                                  IsReadOnly="True" RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="14">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="6" Height="26" RadiusX="3" RadiusY="3"
                                                       Fill="{Binding Team, Converter={StaticResource TeamToBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Pos" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" CornerRadius="4" Padding="7,2"
                                                    Background="{DynamicResource AppAccentSoft}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Position}" Value="1">
                                                                <Setter Property="Background" Value="{DynamicResource AppAccent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Position}" FontFamily="{DynamicResource AppDisplayFont}"
                                                           FontSize="15" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Position}" Value="1">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Driver" Binding="{Binding Name}" Width="190" />
                                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="110" />
                                <DataGridTextColumn Header="Lap" Binding="{Binding CurrentLapNum}" Width="50" />
                                <DataGridTextColumn Header="Last lap" Width="86"
                                                    Binding="{Binding LastLapTimeMs, Converter={StaticResource LapTimeConverter}}" />
                                <DataGridTextColumn Header="S1" Width="64"
                                                    Binding="{Binding Sector1TimeMs, Converter={StaticResource SectorTimeConverter}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.S1Status, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="Green">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppStatusGood}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.S1Status, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="Purple">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppSectorPurple}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="S2" Width="64"
                                                    Binding="{Binding Sector2TimeMs, Converter={StaticResource SectorTimeConverter}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.S2Status, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="Green">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppStatusGood}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.S2Status, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="Purple">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppSectorPurple}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="S3" Width="64"
                                                    Binding="{Binding Sector3TimeMs, Converter={StaticResource SectorTimeConverter}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.S3Status, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="Green">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppStatusGood}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.S3Status, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="Purple">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppSectorPurple}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Gap" Width="72"
                                                    Binding="{Binding GapToLeaderMs, Converter={StaticResource GapConverter}}" />
                                <DataGridTextColumn Header="Interval" Width="72"
                                                    Binding="{Binding GapToCarInFrontMs, Converter={StaticResource GapConverter}}" />
                                <DataGridTextColumn Header="Pits" Binding="{Binding PitStatus, Converter={StaticResource PitStatusConverter}}" Width="70" />
                                <DataGridTextColumn Header="Pen" Binding="{Binding Penalties}" Width="50" />
                                <DataGridTextColumn Header="Tyre" Binding="{Binding TyreCompound, Converter={StaticResource TyreCompoundConverter}}" Width="90" />
                                <DataGridTextColumn Header="Age" Binding="{Binding TyreAgeLaps}" Width="50" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <!-- ContextMenu is attached in code-behind (AttachRowMenu):
                                         Click attributes inside a Setter.Value generate broken
                                         BAML connect code (casts the target to Grid). -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Background" Value="{DynamicResource AppRowHighlight}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppSurfaceAlt}"
                                            BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,6" Margin="26,0,8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{DynamicResource AppAccent}" RadiusX="1.5" RadiusY="1.5" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0">
                                                <Run Text="Lap " /><Run Text="{Binding CurrentLapNum, Mode=OneWay}" />
                                            <Run Text=" · Last " /><Run Text="{Binding LastLapTimeMs, Mode=OneWay, Converter={StaticResource LapTimeConverter}}" />
                                            <Run Text=" · S1 " /><Run Text="{Binding Sector1TimeMs, Mode=OneWay, Converter={StaticResource SectorTimeConverter}}" />
                                            <Run Text=" · S2 " /><Run Text="{Binding Sector2TimeMs, Mode=OneWay, Converter={StaticResource SectorTimeConverter}}" />
                                            <Run Text=" · S3 " /><Run Text="{Binding Sector3TimeMs, Mode=OneWay, Converter={StaticResource SectorTimeConverter}}" />
                                            <Run Text=" · Best " /><Run Text="{Binding BestLapTimeMs, Mode=OneWay, Converter={StaticResource LapTimeConverter}}" />
                                            <Run Text=" · +" /><Run Text="{Binding GapToLeaderMs, Mode=OneWay, Converter={StaticResource GapConverter}}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                        <Border Background="{DynamicResource AppBackground}" Visibility="Collapsed">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Standings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                <TextBlock Text="{Binding EmptyStateText}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="Tipp: Der Listener-Toggle sitzt oben in der Kopfzeile; vergangene Rennen findest du in der History."
                                           FontSize="12" Foreground="{DynamicResource AppMutedForeground}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Player card -->
                            <Border Grid.Column="0" Style="{StaticResource HeroCard}" Padding="16,12,16,14" Margin="0,0,12,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="PLAYER" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock FontFamily="{DynamicResource AppDisplayFont}" FontSize="16" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Player.Name, FallbackValue=No data}" />
                                    </DockPanel>

                                    <!-- Speed hero + gear badge -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <!-- hero speedo: red glow around the digits (F1-TV) -->
                                            <TextBlock Style="{StaticResource StatTileValue}" FontSize="54"
                                                       Text="{Binding Player.Speed, FallbackValue=0}"
                                                       Effect="{DynamicResource AppAccentShadow}" />
                                            <TextBlock Text="KM/H" Style="{StaticResource StatTileCaption}" Margin="2,0,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="56" Height="56" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppCardBorder}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Border CornerRadius="8" Background="{DynamicResource AppGlowRed}" />
                                                <TextBlock Text="{Binding Player.Gear, FallbackValue=-}" FontFamily="{DynamicResource AppDisplayFont}"
                                                           FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppAccent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Gauges -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="THR" Style="{StaticResource EyebrowLabel}" />
                                        <Border Grid.Column="1" Style="{StaticResource GaugeTrack}" Width="190"
                                                VerticalAlignment="Center">
                                            <Border Style="{StaticResource GaugeFill}" Background="{DynamicResource AppStatusGood}"
                                                    Width="{Binding Player.Throttle, Mode=OneWay, Converter={StaticResource PercentToWidth}, ConverterParameter=190, FallbackValue=0}">
                                                <!-- 1 px bright top edge (F1-TV fill highlight) -->
                                                <Rectangle Height="1" Margin="1.5,1.5,1.5,0" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Top" Fill="#59FFFFFF" />
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Player.Throttle, Mode=OneWay, StringFormat={}{0:P0}, FallbackValue=0%}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BRK" Style="{StaticResource EyebrowLabel}" />
                                        <Border Grid.Column="1" Style="{StaticResource GaugeTrack}" Width="190"
                                                VerticalAlignment="Center">
                                            <Border Style="{StaticResource GaugeFill}" Background="{DynamicResource AppStatusCritical}"
                                                    Width="{Binding Player.Brake, Mode=OneWay, Converter={StaticResource PercentToWidth}, ConverterParameter=190, FallbackValue=0}">
                                                <!-- 1 px bright top edge (F1-TV fill highlight) -->
                                                <Rectangle Height="1" Margin="1.5,1.5,1.5,0" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Top" Fill="#59FFFFFF" />
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Player.Brake, Mode=OneWay, StringFormat={}{0:P0}, FallbackValue=0%}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ERS" Style="{StaticResource EyebrowLabel}" />
                                        <Border Grid.Column="1" Style="{StaticResource GaugeTrack}" Width="190"
                                                VerticalAlignment="Center">
                                            <Border Style="{StaticResource GaugeFill}" Background="{DynamicResource AppStatusInfo}"
                                                    Width="{Binding Player.ErsPercent, Mode=OneWay, Converter={StaticResource PercentToWidth}, ConverterParameter=190, FallbackValue=0}">
                                                <!-- 1 px bright top edge (F1-TV fill highlight) -->
                                                <Rectangle Height="1" Margin="1.5,1.5,1.5,0" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Top" Fill="#59FFFFFF" />
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Player.ErsPercent, Mode=OneWay, StringFormat={}{0:0}%, FallbackValue=0%}" />
                                    </Grid>

                                    <!-- Status lines -->
                                    <TextBlock Margin="0,2,0,0">
                                        <Run Text="Fuel " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.FuelInTank, Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                        <Run Text=" kg · " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.FuelRemainingLaps, Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                        <Run Text=" laps" Foreground="{DynamicResource AppDimForeground}" />
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="ERS mode " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.ErsDeployMode, Mode=OneWay, FallbackValue=–}" />
                                        <Run Text=" · DRS " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.IsDrsOn, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Brake bias " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.FrontBrakeBias, Mode=OneWay, StringFormat={}{0}% front, FallbackValue=–}" />
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Steer " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.Steer, Mode=OneWay, StringFormat={}{0:+0.00;-0.00}, FallbackValue=0.00}" />
                                        <Run Text=" · G " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.GLat, Mode=OneWay, StringFormat={}{0:+0.00;-0.00}, FallbackValue=0.00}" />
                                        <Run Text=" lat / " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Player.GLong, Mode=OneWay, StringFormat={}{0:+0.00;-0.00}, FallbackValue=0.00}" />
                                        <Run Text=" long" Foreground="{DynamicResource AppDimForeground}" />
                                    </TextBlock>

                                    <!-- Tyre quadrant -->
                                    <TextBlock Text="TYRES — PSI · SURFACE / BRAKE °C" Style="{StaticResource StatTileCaption}"
                                               Margin="0,10,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="6" Background="{DynamicResource AppSurface}"
                                                BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                                                Padding="8,6" Margin="0,0,6,6">
                                            <Grid>
                                                <Rectangle Fill="{Binding Player.Wheels.SurfaceTemp[0], Mode=OneWay, Converter={StaticResource TyreTempToBrush}}"
                                                           RadiusX="5" RadiusY="5" Opacity="0.30" />
                                                <StackPanel>
                                                    <TextBlock Text="FL" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource MonoText}" FontSize="12">
                                                        <Run Text="{Binding Player.Wheels.Pressure[0], Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                                        <Run Text=" psi · " />
                                                        <Run Text="{Binding Player.Wheels.SurfaceTemp[0], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="° / " />
                                                        <Run Text="{Binding Player.Wheels.BrakeTemp[0], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="°" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource AppSurface}"
                                                BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                                                Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Rectangle Fill="{Binding Player.Wheels.SurfaceTemp[1], Mode=OneWay, Converter={StaticResource TyreTempToBrush}}"
                                                           RadiusX="5" RadiusY="5" Opacity="0.30" />
                                                <StackPanel>
                                                    <TextBlock Text="FR" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource MonoText}" FontSize="12">
                                                        <Run Text="{Binding Player.Wheels.Pressure[1], Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                                        <Run Text=" psi · " />
                                                        <Run Text="{Binding Player.Wheels.SurfaceTemp[1], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="° / " />
                                                        <Run Text="{Binding Player.Wheels.BrakeTemp[1], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="°" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource AppSurface}"
                                                BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                                                Padding="8,6" Margin="0,0,6,0">
                                            <Grid>
                                                <Rectangle Fill="{Binding Player.Wheels.SurfaceTemp[2], Mode=OneWay, Converter={StaticResource TyreTempToBrush}}"
                                                           RadiusX="5" RadiusY="5" Opacity="0.30" />
                                                <StackPanel>
                                                    <TextBlock Text="RL" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource MonoText}" FontSize="12">
                                                        <Run Text="{Binding Player.Wheels.Pressure[2], Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                                        <Run Text=" psi · " />
                                                        <Run Text="{Binding Player.Wheels.SurfaceTemp[2], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="° / " />
                                                        <Run Text="{Binding Player.Wheels.BrakeTemp[2], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="°" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="6" Background="{DynamicResource AppSurface}"
                                                BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" Padding="8,6">
                                            <Grid>
                                                <Rectangle Fill="{Binding Player.Wheels.SurfaceTemp[3], Mode=OneWay, Converter={StaticResource TyreTempToBrush}}"
                                                           RadiusX="5" RadiusY="5" Opacity="0.30" />
                                                <StackPanel>
                                                    <TextBlock Text="RR" Style="{StaticResource StatTileCaption}" />
                                                    <TextBlock Style="{StaticResource MonoText}" FontSize="12">
                                                        <Run Text="{Binding Player.Wheels.Pressure[3], Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                                        <Run Text=" psi · " />
                                                        <Run Text="{Binding Player.Wheels.SurfaceTemp[3], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="° / " />
                                                        <Run Text="{Binding Player.Wheels.BrakeTemp[3], Mode=OneWay, StringFormat={}{0:0}, FallbackValue=–}" />
                                                        <Run Text="°" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Rival card -->
                            <Border Grid.Column="1" Style="{StaticResource BroadcastCard}" Padding="16,12,16,14" Margin="12,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="RIVAL" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock FontFamily="{DynamicResource AppDisplayFont}" FontSize="16" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Rival.Name, FallbackValue=No data}" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <!-- hero speedo: red glow around the digits (F1-TV) -->
                                            <TextBlock Style="{StaticResource StatTileValue}" FontSize="54"
                                                       Text="{Binding Rival.Speed, FallbackValue=0}"
                                                       Effect="{DynamicResource AppAccentShadow}" />
                                            <TextBlock Text="KM/H" Style="{StaticResource StatTileCaption}" Margin="2,0,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="56" Height="56" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{DynamicResource AppSurfaceAlt}" BorderBrush="{DynamicResource AppCardBorder}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Border CornerRadius="8" Background="{DynamicResource AppGlowRed}" />
                                                <TextBlock Text="{Binding Rival.Gear, FallbackValue=-}" FontFamily="{DynamicResource AppDisplayFont}"
                                                           FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppAccent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="THR" Style="{StaticResource EyebrowLabel}" />
                                        <Border Grid.Column="1" Style="{StaticResource GaugeTrack}" Width="190"
                                                VerticalAlignment="Center">
                                            <Border Style="{StaticResource GaugeFill}" Background="{DynamicResource AppStatusGood}"
                                                    Width="{Binding Rival.Throttle, Mode=OneWay, Converter={StaticResource PercentToWidth}, ConverterParameter=190, FallbackValue=0}">
                                                <!-- 1 px bright top edge (F1-TV fill highlight) -->
                                                <Rectangle Height="1" Margin="1.5,1.5,1.5,0" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Top" Fill="#59FFFFFF" />
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Rival.Throttle, Mode=OneWay, StringFormat={}{0:P0}, FallbackValue=0%}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BRK" Style="{StaticResource EyebrowLabel}" />
                                        <Border Grid.Column="1" Style="{StaticResource GaugeTrack}" Width="190"
                                                VerticalAlignment="Center">
                                            <Border Style="{StaticResource GaugeFill}" Background="{DynamicResource AppStatusCritical}"
                                                    Width="{Binding Rival.Brake, Mode=OneWay, Converter={StaticResource PercentToWidth}, ConverterParameter=190, FallbackValue=0}">
                                                <!-- 1 px bright top edge (F1-TV fill highlight) -->
                                                <Rectangle Height="1" Margin="1.5,1.5,1.5,0" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Top" Fill="#59FFFFFF" />
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Rival.Brake, Mode=OneWay, StringFormat={}{0:P0}, FallbackValue=0%}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ERS" Style="{StaticResource EyebrowLabel}" />
                                        <Border Grid.Column="1" Style="{StaticResource GaugeTrack}" Width="190"
                                                VerticalAlignment="Center">
                                            <Border Style="{StaticResource GaugeFill}" Background="{DynamicResource AppStatusInfo}"
                                                    Width="{Binding Rival.ErsPercent, Mode=OneWay, Converter={StaticResource PercentToWidth}, ConverterParameter=190, FallbackValue=0}">
                                                <!-- 1 px bright top edge (F1-TV fill highlight) -->
                                                <Rectangle Height="1" Margin="1.5,1.5,1.5,0" RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Top" Fill="#59FFFFFF" />
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="12" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Rival.ErsPercent, Mode=OneWay, StringFormat={}{0:0}%, FallbackValue=0%}" />
                                    </Grid>

                                    <TextBlock Margin="0,2,0,0">
                                        <Run Text="Fuel " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Rival.FuelInTank, Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                        <Run Text=" kg · " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Rival.FuelRemainingLaps, Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=–}" />
                                        <Run Text=" laps" Foreground="{DynamicResource AppDimForeground}" />
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="ERS mode " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Rival.ErsDeployMode, Mode=OneWay, FallbackValue=–}" />
                                        <Run Text=" · DRS " Foreground="{DynamicResource AppDimForeground}" />
                                        <Run FontFamily="{DynamicResource AppNumFont}" Text="{Binding Rival.IsDrsOn, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Comparison -->
                            <Border Grid.Column="2" Style="{StaticResource BroadcastCard}" Padding="16,12,16,14" Margin="12,0,0,0"
                                    Background="{DynamicResource AppCardHighlight}">
                                <StackPanel>
                                    <TextBlock Text="TEAM TELEMETRY — DELTAS (YOU VS RIVAL)"
                                               Style="{StaticResource StatTileCaption}" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SPEED DELTA" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource AppStatusGood}"
                                                   Text="{Binding Comparison.SpeedDeltaKph, StringFormat={}{0} km/h, FallbackValue=—}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="THROTTLE DELTA" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource AppStatusGood}"
                                                   Text="{Binding Comparison.ThrottleDelta, StringFormat={}{0:P0}, FallbackValue=—}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BRAKE DELTA" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource AppStatusGood}"
                                                   Text="{Binding Comparison.BrakeDelta, StringFormat={}{0:P0}, FallbackValue=—}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ERS DELTA" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource AppStatusGood}"
                                                   Text="{Binding Comparison.ErsDeltaPercent, StringFormat={}{0:0}%, FallbackValue=—}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FUEL DELTA" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource AppStatusGood}"
                                                   Text="{Binding Comparison.FuelDelta, StringFormat={}{0:0.0} kg, FallbackValue=—}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BEST LAP" Style="{StaticResource EyebrowLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource AppStatusGood}"
                                                   Text="{Binding Comparison.BestLapDeltaMs, StringFormat=you are {0:+0.000;-0.000} s, FallbackValue=—}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Comparison.Note}"
                                               Foreground="{DynamicResource AppBannerText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===== Race Control ===== -->
                    <Grid x:Name="RaceControlTab" Visibility="Collapsed" Margin="16,14,16,16">
                        <ListBox ItemsSource="{Binding RaceEvents}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2" Height="44">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Margin="12,0,0,0"
                                                   Style="{StaticResource MonoText}" FontSize="12" Opacity="0.55"
                                                   VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="34"
                                                CornerRadius="11" Padding="10,2" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AppNeutral}" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="fastest-lap">
                                                            <Setter Property="Background" Value="{DynamicResource AppStatusGood}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="penalty">
                                                            <Setter Property="Background" Value="{DynamicResource AppStatusWarn}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="retirement">
                                                            <Setter Property="Background" Value="{DynamicResource AppStatusCritical}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="race-winner">
                                                            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="session-started">
                                                            <Setter Property="Background" Value="{DynamicResource AppStatusInfo}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="personal-best">
                                                            <Setter Property="Background" Value="{DynamicResource AppSectorPurple}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AppAccentText}" />
                                        </Border>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ===== History ===== -->
                    <Grid x:Name="HistoryTab" Visibility="Collapsed" Margin="16,14,16,16">
                        <local:HistoryTabView />
                    </Grid>

                    <Grid x:Name="ReportTab" Visibility="Collapsed" Margin="16,14,16,16">
                        <local:RaceReportView x:Name="ReportView" />
                    </Grid>

                    <!-- ===== Setups ===== -->
                    <Grid x:Name="SetupsTab" Visibility="Collapsed" Margin="16,14,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Rectangle Style="{StaticResource AccentTick}" />
                                <TextBlock Text="TRACK-SETUPS" Style="{StaticResource BroadcastCardHeader}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Lädt die Track-Setups, die dein Discord-Account auf erdi-erc.de sehen darf, und erzeugt daraus einen ERC1-Share-Code für F1 26."
                                       Style="{StaticResource SettingsSectionHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Setups laden" Click="SetupsLoad_Click" Padding="10,2"
                                        VerticalAlignment="Center"
                                        ToolTip="Lädt die für deinen Discord-Zugriff freigegebenen Setups von der Website." />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding UserText, Mode=OneWay}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                           Text="{Binding Status, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{Binding LoadStatus, Mode=OneWay}"
                                       Style="{StaticResource SettingsSectionHint}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Strecke" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="180" ItemsSource="{Binding Tracks}"
                                          SelectedItem="{Binding SelectedTrack}" />
                                <TextBlock Text="Jahr" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <ComboBox Width="100" ItemsSource="{Binding GameYears}"
                                          SelectedItem="{Binding SelectedGameYear}" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Setups}"
                                 SelectedItem="{Binding SelectedSetup}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2" Height="40">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GameYear}" Margin="12,0,0,0"
                                                   Style="{StaticResource MonoText}" FontSize="12" Opacity="0.55"
                                                   VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Track}" FontSize="11" Opacity="0.6"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Style="{StaticResource BroadcastCard}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ERC1-SHARE-CODE" Style="{StaticResource SettingsSubHeader}" />
                                <TextBlock Text="Kopiere den Code und importiere ihn in F1 26 (Setup → Import)."
                                           Style="{StaticResource SettingsSectionHint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox x:Name="Erc1CodeBox" Width="420" IsReadOnly="True"
                                             Text="{Binding Erc1Code, Mode=OneWay}"
                                             FontFamily="{DynamicResource AppNumFont}" />
                                    <Button Content="Code kopieren" Click="CopyErc1Code_Click" Padding="10,2"
                                            Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Settings ===== -->
                    <Grid x:Name="SettingsTab" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: category sidebar (Discord-style) -->
                        <Border Grid.Column="0" Background="{DynamicResource AppSurface}"
                                BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="EINSTELLUNGEN"
                                           Style="{StaticResource BroadcastSectionLabel}" Margin="16,14,16,8" />
                                <ListBox x:Name="SettingsNav" Style="{StaticResource NavRailListBox}"
                                         SelectionChanged="SettingsNav_SelectionChanged">
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="verbindung">
                                        <TextBlock Text="VERBINDUNG" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="ai">
                                        <TextBlock Text="AI-KOMMENTATOR" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="weiterleitung">
                                        <TextBlock Text="WEITERLEITUNG" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="darstellung">
                                        <TextBlock Text="DARSTELLUNG" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="fahrer">
                                        <TextBlock Text="FAHRER &amp; RIVAL" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="verhalten">
                                        <TextBlock Text="VERHALTEN" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="twitch">
                                        <TextBlock Text="TWITCH-CHAT" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="clips">
                                        <TextBlock Text="KOLLISIONS-CLIPS" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="hud">
                                        <TextBlock Text="IN-GAME-OVERLAY" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="overlays">
                                        <TextBlock Text="OVERLAYS (OBS)" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource NavItemContainer}" Tag="erc">
                                        <TextBlock Text="ERC-ERGEBNIS" FontFamily="{DynamicResource AppDisplayFont}" FontSize="14" />
                                    </ListBoxItem>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Right: selected section + pinned save bar -->
                        <DockPanel Grid.Column="1">
                            <!-- save bar pinned below the groups — visible without scrolling -->
                            <Border DockPanel.Dock="Bottom" Padding="16,10"
                                    Background="{DynamicResource AppSurfaceAlt}"
                                    BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button Content="SPEICHERN" Click="SaveSettings_Click" MinWidth="140" Padding="16,4"
                                                Style="{StaticResource BroadcastPrimaryButton}"
                                                ToolTip="Persistiert alle Einstellungen; HUD-Änderungen greifen sofort" />
                                        <Button Content="Auf Standard zurücksetzen" Click="ResetSettings_Click"
                                                Margin="10,0,0,0" Padding="14,4"
                                                ToolTip="Setzt alle Felder dieses Tabs auf die App-Standardwerte zurück — erst nach SPEICHERN wird es wirksam." />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatus}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontStyle="Italic"
                                               Foreground="{DynamicResource AppDimForeground}" />
                                    <TextBlock Text="{Binding SaveHint}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AppStatusGood}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppStatusWarn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="20,16,20,16">
                                    <Border x:Name="SettingsCardVerbindung" Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Rectangle Style="{StaticResource AccentTick}" />
                                                <TextBlock Text="VERBINDUNG" Style="{StaticResource BroadcastCardHeader}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Ports und Startverhalten der Telemetrie-Verbindung."
                                                       Style="{StaticResource SettingsSectionHint}" />

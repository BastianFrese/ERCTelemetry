<UserControl x:Class="ERCTelemetry.App.Dashboard.RaceReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="1200" HorizontalAlignment="Left">

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RENNREPORT" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding HeaderLine}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Opacity="0.85" />
                            <TextBlock Text="{Binding KpiLine}" Margin="0,4,0,0"
                                       FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹ Zurück zur History" Click="OnBackToHistory" Padding="12,6"
                                        ToolTip="Kehrt zur Session-Liste zurück (der Report ist nur über die History erreichbar)" />
                                <Button Content="Export HTML" Click="OnExportHtml" Padding="12,6" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="SESSION" Style="{StaticResource StatTileCaption}" />
                            <ComboBox ItemsSource="{Binding Sessions}"
                                      SelectedItem="{Binding SelectedSession}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="FAHRER A" Style="{StaticResource StatTileCaption}" />
                            <ComboBox ItemsSource="{Binding Drivers}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding DriverA}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="FAHRER B" Style="{StaticResource StatTileCaption}" />
                            <ComboBox ItemsSource="{Binding Drivers}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding DriverB}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Status}" Margin="0,8,0,0" FontStyle="Italic"
                               Opacity="0.7" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding SummaryTitle}" FontSize="16" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding SummaryParagraphs}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LlmSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontStyle="Italic" Opacity="0.85" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding CoachTitle}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding CoachSummary}" Margin="0,4,0,0" FontStyle="Italic"
                               Opacity="0.7" />
                    <ItemsControl ItemsSource="{Binding CoachFindings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LlmCoach}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontStyle="Italic" Opacity="0.85" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ERGEBNIS &amp; FELD" FontSize="16" FontWeight="Bold" />
                    <DataGrid ItemsSource="{Binding Classification}" Margin="0,8,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="P" Binding="{Binding Position}" />
                            <DataGridTextColumn Header="Fahrer" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Team" Binding="{Binding Team}" />
                            <DataGridTextColumn Header="#" Binding="{Binding RaceNumber}" />
                            <DataGridTextColumn Header="Rd" Binding="{Binding Laps}" />
                            <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" />
                            <DataGridTextColumn Header="Pts" Binding="{Binding Points}" />
                            <DataGridTextColumn Header="Best" Binding="{Binding Best}" />
                            <DataGridTextColumn Header="Gap" Binding="{Binding Delta}" />
                            <DataGridTextColumn Header="Ø" Binding="{Binding Average}" />
                            <DataGridTextColumn Header="σ" Binding="{Binding Sigma}" />
                            <DataGridTextColumn Header="Valid" Binding="{Binding LapsValid}" />
                            <DataGridTextColumn Header="Stops" Binding="{Binding PitStops}" />
                            <DataGridTextColumn Header="+/-" Binding="{Binding Gained}" />
                            <DataGridTextColumn Header="Lead" Binding="{Binding Led}" />
                            <DataGridTextColumn Header="Pen" Binding="{Binding Penalties}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PACE &amp; CHARTS" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Rundenzeiten" Style="{StaticResource StatTileCaption}"
                               Margin="0,8,0,2" />
                    <Canvas x:Name="LapTimesCanvas" Height="220" />
                    <TextBlock Text="Trace-Duell (Speed über Streckendistanz)"
                               Style="{StaticResource StatTileCaption}" Margin="0,8,0,2" />
                    <Canvas x:Name="TraceDuelCanvas" Height="220" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="STINTS (SPIELER)" FontSize="16" FontWeight="Bold" />
                    <DataGrid ItemsSource="{Binding StintRows}" Margin="0,8,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stint" Binding="{Binding Stint}" />
                            <DataGridTextColumn Header="Reifen" Binding="{Binding Tyre}" />
                            <DataGridTextColumn Header="Spanne" Binding="{Binding Span}" />
                            <DataGridTextColumn Header="Best" Binding="{Binding Best}" />
                            <DataGridTextColumn Header="Ø" Binding="{Binding Average}" />
                            <DataGridTextColumn Header="Degr." Binding="{Binding Degradation}" />
                            <DataGridTextColumn Header="σ" Binding="{Binding Sigma}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SETUP (SPIELER)" FontSize="16" FontWeight="Bold" />
                        <Button Grid.Column="1" Content="Code kopieren" Click="OnCopySetupCode"
                                Padding="12,6" ToolTip="Kopiert den Share-Code in die Zwischenablage" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SetupRows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Opacity="0.7" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               FontFamily="Cascadia Mono" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Share-Code" Style="{StaticResource StatTileCaption}"
                               Margin="0,10,0,2" />
                    <TextBox x:Name="SetupCodeBox" Text="{Binding SetupCode, Mode=OneWay}"
                             IsReadOnly="True" FontFamily="Cascadia Mono" Margin="0,0,0,6"
                             ToolTip="Dieser Code lässt sich in Chat/Discord teilen" />
                    <TextBlock Text="Code importieren" Style="{StaticResource StatTileCaption}"
                               Margin="0,6,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SetupImportBox" FontFamily="Cascadia Mono"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Füge hier einen ERC1-Code ein und klicke auf Importieren" />
                        <Button Grid.Column="1" Content="Importieren" Click="OnImportSetupCode"
                                Padding="12,6" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding SetupStatus}" Margin="0,6,0,0" FontStyle="Italic"
                               Opacity="0.7" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource BroadcastCard}" Grid.Column="0" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="TIMELINE" FontSize="14" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Timeline}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BroadcastCard}" Grid.Column="1" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SCHADEN" FontSize="14" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding DamageRows}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BroadcastCard}" Grid.Column="2" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DUELL-TIPPS" FontSize="14" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding DuelTips}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

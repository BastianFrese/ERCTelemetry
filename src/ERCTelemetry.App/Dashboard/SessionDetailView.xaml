<UserControl x:Class="ERCTelemetry.App.Dashboard.SessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <!-- Detail-Header: back, export buttons, session title. -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="‹ Zurück zu den Sessions"
                            Click="Back_Click" Padding="12,2" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Export JSON…" Click="ExportJson_Click" Padding="12,2" />
                        <Button Content="Export CSV…" Click="ExportCsv_Click" Padding="12,2" Margin="8,0,0,0" />
                        <Button Content="Export laps CSV…" Click="ExportLapsCsv_Click" Padding="12,2" Margin="8,0,0,0"
                                ToolTip="Exportiert die Runden des oben gewählten Fahrers (Runde, Zeit, Sektoren, Reifen)" />
                        <Button Content="Report öffnen…" Click="OpenReport_Click" Padding="12,2" Margin="8,0,0,0"
                                ToolTip="Öffnet die gewählte Session im Rennreport-Tab" />
                        <Button Content="Session teilen…" Click="ShareSession_Click" Padding="12,2" Margin="8,0,0,0"
                                IsEnabled="{Binding IsSharing, Converter={StaticResource InverseBool}}"
                                ToolTip="Lädt Session-Daten und Kollisions-Clips auf telemetrie.erdi-erc.de hoch und kopiert den Link in die Zwischenablage" />
                        <TextBlock Text="{Binding ShareStatus}" Margin="12,0,0,0"
                                   FontStyle="Italic" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedForeground}" />
                        <TextBlock Text="{Binding Status}" Margin="12,0,0,0"
                                   FontStyle="Italic" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedForeground}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedSession.Title}" FontSize="14"
                               FontWeight="SemiBold" Margin="16,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}" />
                </DockPanel>
            </Border>
            <!-- ===== ERGEBNISSE & PACE ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ERGEBNISSE &amp; PACE" Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="40" />
                            <DataGridTextColumn Header="Driver" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="100" />
                            <DataGridTextColumn Header="Laps" Binding="{Binding Laps}" Width="40" />
                            <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="40" />
                            <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="50" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Best lap" Binding="{Binding BestLap}" Width="70" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80" />
                            <DataGridTextColumn Header="Pen" Binding="{Binding Penalties}" Width="40" />
                            <DataGridTextColumn Header="#Pen" Binding="{Binding NumPenalties}" Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding PaceSummary}" Margin="0,12,0,4"
                               Foreground="{DynamicResource AppMutedForeground}" />
                    <DataGrid ItemsSource="{Binding StintRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stint" Binding="{Binding Stint}" Width="55" />
                            <DataGridTextColumn Header="Tyre" Binding="{Binding Tyre}" Width="55" />
                            <DataGridTextColumn Header="Laps" Binding="{Binding Span}" Width="100" />
                            <DataGridTextColumn Header="Best" Binding="{Binding Best}" Width="80" />
                            <DataGridTextColumn Header="Ø Lap" Binding="{Binding Average}" Width="80" />
                            <DataGridTextColumn Header="Deg" Binding="{Binding Degradation}" Width="90" />
                            <DataGridTextColumn Header="σ" Binding="{Binding Sigma}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="KONSISTENZ ALLER FAHRER (GEWÄHLTE SESSION)" Style="{StaticResource StatTileCaption}"
                               Margin="0,12,0,4" />
                    <DataGrid ItemsSource="{Binding ConsistencyRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fahrer" Binding="{Binding Driver}" Width="140" />
                            <DataGridTextColumn Header="Runden" Binding="{Binding Laps}" Width="60" />
                            <DataGridTextColumn Header="Best" Binding="{Binding Best}" Width="80" />
                            <DataGridTextColumn Header="Ø Lap" Binding="{Binding Average}" Width="80" />
                            <DataGridTextColumn Header="σ" Binding="{Binding Sigma}" Width="70" />
                            <DataGridTextColumn Header="Konsistenz" Binding="{Binding Score}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ===== ANALYSEN (eingeklappt — die Detail-Ansicht bleibt aufs Wesentliche reduziert) ===== -->
            <Expander Header="ANALYSEN" IsExpanded="False" Margin="0,0,0,12">
                <StackPanel Margin="0,8,0,0">
            <!-- ===== POSITIONEN & RUNDEN ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="POSITIONEN &amp; RUNDEN" Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Driver:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppForeground}" />
                        <ComboBox Width="220" ItemsSource="{Binding Drivers}"
                                  SelectedItem="{Binding SelectedDriver}"
                                  DisplayMemberPath="Name" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForeground}">
                            <Run Text="Position chart — lap 1.." /><Run Text="{Binding LapCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" CornerRadius="6"
                            Margin="0,0,0,12" Padding="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="ChartCanvas" Width="800" Height="114" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Runde A/B:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppForeground}" />
                        <ComboBox x:Name="TraceAPicker" Width="180" IsEnabled="{Binding HasTraceLaps}"
                                  ItemsSource="{Binding TraceLaps}" SelectedItem="{Binding SelectedTraceA}"
                                  DisplayMemberPath="Label" />
                        <TextBlock Text="vs. Runde B:" VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="{DynamicResource AppForeground}" />
                        <ComboBox x:Name="TraceBPicker" Width="180" IsEnabled="{Binding TraceBPickerEnabled}"
                                  ItemsSource="{Binding TraceLaps}" SelectedItem="{Binding SelectedTraceB}"
                                  DisplayMemberPath="Label" />
                        <CheckBox Content="vs. Strecken-Bestzeit (alle Sessions)"
                                  IsChecked="{Binding CompareVsTrackBest}" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Vergleicht Runde A mit der schnellsten aufgezeichneten Runde dieser Strecke über alle Sessions hinweg (Cross-Session-Referenz)." />
                        <TextBlock Text="{Binding TraceHint}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontStyle="Italic"
                                   Foreground="{DynamicResource AppForeground}" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1" CornerRadius="6"
                            Padding="4" Margin="0,0,0,6">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Canvas x:Name="TraceCanvas" Width="800" Height="150" />
                        </ScrollViewer>
                    </Border>
                    <ListBox ItemsSource="{Binding TraceTips}" DisplayMemberPath="Text" MaxHeight="140"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="loss">
                                        <Setter Property="Foreground" Value="{DynamicResource AppBannerText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="gain">
                                        <Setter Property="Foreground" Value="{DynamicResource AppStatusGood}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="brake">
                                        <Setter Property="Foreground" Value="{DynamicResource AppStatusWarn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="apex">
                                        <Setter Property="Foreground" Value="{DynamicResource AppStatusWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="TIMEKILLER – KURVEN MIT DEM GRÖSSTEN ZEITVERLUST"
                               Style="{StaticResource StatTileCaption}" Margin="0,12,0,4" />
                    <ListBox ItemsSource="{Binding TraceCornerTexts}" MaxHeight="110"
                             BorderThickness="0" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- ===== SITZUNGSVERGLEICH ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SITZUNGSVERGLEICH" Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Session B:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppForeground}" />
                        <ComboBox Width="260" ItemsSource="{Binding Sessions}"
                                  SelectedItem="{Binding CompareSessionB}"
                                  DisplayMemberPath="Title" />
                        <Button Content="Vergleichen" Click="Compare_Click"
                                Padding="12,2" Margin="12,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding CompareRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Driver" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Best A" Binding="{Binding BestA}" Width="80" />
                            <DataGridTextColumn Header="Best B" Binding="{Binding BestB}" Width="80" />
                            <DataGridTextColumn Header="Δ Lap" Binding="{Binding LapDelta}" Width="70" />
                            <DataGridTextColumn Header="Δ S1" Binding="{Binding S1Delta}" Width="60" />
                            <DataGridTextColumn Header="Δ S2" Binding="{Binding S2Delta}" Width="60" />
                            <DataGridTextColumn Header="Δ S3" Binding="{Binding S3Delta}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ===== STRAFEN & VERWARNUNGEN (pro Runde / Kurve) ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12"
                    ToolTip="Strafen und Verwarnungen gruppiert pro Runde mit Ort (Kurve/Sektor/Prozent). Sessions, die vor dieser Funktion gespeichert wurden, zeigen „—” statt Ort, da die Distanz erst ab diesem Release gestempelt wird.">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PenaltySummary}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AppMutedForeground}" />
                        <TextBlock Text="STRAFEN &amp; VERWARNUNGEN (PRO RUNDE / KURVE)"
                                   Style="{StaticResource StatTileCaption}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PenaltyGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Text="{Binding LapLabel}" Style="{StaticResource EyebrowLabel}" />
                                    <ItemsControl ItemsSource="{Binding Incidents}" Margin="14,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2,0,0">
                                                    <Border DockPanel.Dock="Left" CornerRadius="3"
                                                            Padding="5,1" Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1" MinWidth="80">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentText}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppStatusWarn}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="CornerCuttingWarning">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppStatusWarn}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppStatusWarn}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="CornerCuttingWarning">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppStatusWarn}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Place}"
                                                               FontSize="11" Margin="0,0,12,0" MinWidth="240"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppMutedForeground}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource AppForeground}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Keine Vorfälle in dieser Session."
                               Foreground="{DynamicResource AppMutedForeground}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PenaltyGroups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
                </StackPanel>
            </Expander>

            <!-- ===== KOLLISIONS-CLIPS ===== -->
            <Border Style="{StaticResource BroadcastCard}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Ordner öffnen…" Click="OpenClipFolder_Click"
                                Padding="12,2" VerticalAlignment="Center"
                                ToolTip="Öffnet den Clip-Ordner dieser Session im Explorer" />
                        <TextBlock Text="KOLLISIONS-CLIPS" Style="{StaticResource StatTileCaption}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Clips}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Runde" Binding="{Binding Lap}" Width="55" />
                            <DataGridTextColumn Header="Beteiligte" Binding="{Binding Drivers}" Width="*" />
                            <DataGridTextColumn Header="Schwere" Binding="{Binding Severity}" Width="70" />
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="70" />
                            <DataGridTextColumn Header="Dauer" Binding="{Binding Duration}" Width="60" />
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Abspielen" Click="PlayClip_Click" Padding="8,1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Keine Kollisions-Clips in dieser Session."
                               Foreground="{DynamicResource AppMutedForeground}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Clips.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== EREIGNISSE ===== -->
            <Border Style="{StaticResource BroadcastCard}">
                <StackPanel>
                    <TextBlock Text="EREIGNISSE" Style="{StaticResource StatTileCaption}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding OvertakeRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Runde" Binding="{Binding Lap}" Width="55" />
                            <DataGridTextColumn Header="Manöver" Binding="{Binding Text}" Width="*" />
                            <DataGridTextColumn Header="Neue Pos." Binding="{Binding Position}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox ItemsSource="{Binding Events}"
                             
                             FontFamily="Consolas" FontSize="11" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

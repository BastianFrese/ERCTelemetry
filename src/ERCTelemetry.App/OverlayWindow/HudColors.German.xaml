<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- German scheme: erdi-erc.de dark tokens with black-red-gold accents.
         Identical to HudColors.Classic.xaml except HudAccent / HudGold / HudThrottle —
         keys are a fixed contract (swap at merge index, DynamicResource consumers,
         overlay.js "scheme-de" mirrors the same hues on the web side). -->
    <SolidColorBrush x:Key="HudBg" Color="#EA030407" />
    <SolidColorBrush x:Key="HudBorder" Color="#232833" />
    <SolidColorBrush x:Key="HudText" Color="#F4F6FB" />
    <SolidColorBrush x:Key="HudMuted" Color="#B8BFCB" />
    <SolidColorBrush x:Key="HudAccent" Color="#FF3311" />
    <SolidColorBrush x:Key="HudBarTrack" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HudThrottle" Color="#FFCE00" />
    <SolidColorBrush x:Key="HudBrake" Color="#FF5A4E" />
    <SolidColorBrush x:Key="HudErs" Color="#6EA8FE" />
    <SolidColorBrush x:Key="HudDRS" Color="#6EA8FE" />
    <SolidColorBrush x:Key="HudGold" Color="#FFCE00" />
    <SolidColorBrush x:Key="HudGreen" Color="#35D07F" />
    <SolidColorBrush x:Key="HudRed" Color="#FF5A4E" />
    <SolidColorBrush x:Key="HudPurple" Color="#B45CFF" />

    <!-- RPM bar fill: green → German gold → red (matches the #FFCE00 throttle, unlike
         the overlay's old hardcoded GradientStops which used Classic gold). -->
    <LinearGradientBrush x:Key="HudRpmGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#35D07F" Offset="0" />
        <GradientStop Color="#FFCE00" Offset="0.6" />
        <GradientStop Color="#FF5A4E" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
<?xml version="1.0" encoding="utf-8"?>
<!--
  Web download release: self-contained win-x64 publish staged into installer/stage,
  from which installer/ERCTelemetry.iss (Inno Setup) builds the Setup.exe that users
  download from the project website. Build via installer/build-installer.ps1.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>WebRelease</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>..\..\installer\stage\</PublishDir>
  </PropertyGroup>
</Project>
<?xml version="1.0" encoding="utf-8"?>
<!--
  VS publish profile: publishes self-contained win-x64 into installer/stage and then
  builds the Setup.exe (Inno Setup) and copies it to the website server share
  (path in installer/server-target.txt). This is the "publish to the website server"
  profile - pick it in Visual Studio's Publish dialog, or CLI:
    dotnet publish src/ERCTelemetry.App/ERCTelemetry.App.csproj -p:PublishProfile=WebServer
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>WebServer</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>..\..\installer\stage\</PublishDir>
  </PropertyGroup>

  <!-- After the publish, build the installer from the staged output and upload.
       -SkipPublish: the stage was just produced by this publish (script must not clean it).
       GetFullPath normalizes the ..\..\ segments away - powershell -File rejects
       unnormalized paths passed through cmd (file "not present" error, exit -196608).
       Base is MSBuildProjectDirectory (= src\ERCTelemetry.App), so ..\..\ = repo root. -->
  <Target Name="BuildInstallerAndUpload" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\installer\build-installer.ps1'))&quot; -SkipPublish"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />
  </Target>
</Project>
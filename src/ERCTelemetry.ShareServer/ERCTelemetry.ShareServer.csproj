<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ERCTelemetry.ShareServer</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERCTelemetry.Core\ERCTelemetry.Core.csproj" />
  </ItemGroup>

  <!-- The cleanup sweep's CleanupOnce is internal so the integration tests can drive a
       sweep synchronously instead of waiting on the hourly timer. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ERCTelemetry.ShareServer.Tests" />
  </ItemGroup>

</Project>
